# Initial 64-bit candidate. Confirm the actual EeePC CPU before deployment.
CONFIG_LOCALVERSION="-ainow-eeepc-1005p"
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y

# EeePC hardware inventory: Atheros AR8132 (1969:1062) and AR9285 (168c:002b).
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ATL1C=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y

# ICH7 HDA controller (8086:27d8). Codec verification is pending on hardware.
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y

# Provide a local text console after i915 takes over from the boot display.
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
